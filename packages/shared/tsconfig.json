{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["ES2020", "DOM"],
        "baseUrl": ".",
        "paths": {
            "shared/*": ["modules/*"]
        },
        "rootDir": "./modules",
        "outDir": "./dist/modules",
        "sourceMap": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": ["modules/**/*.ts", "modules/**/*.d.ts"],
    "exclude": ["dist", "node_modules"]
}
