{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["ES2020", "DOM"],
        "baseUrl": ".",
        "paths": {
            "core/*": ["../app/core/*"],
            "editor/*": ["../app/editor/*"],
            "slds/*": ["../app/component/slds/*"],
            "shared/*": ["../../shared/modules/*"],
            "core/applications": ["../app/core/applications/applications"],
            "core/constant": ["../app/core/constant/constant"],
            "editor/editorCompleteWidget": ["../app/editor/editorCompleteWidget/editorCompleteWidget"],
            "editor/languages": ["../app/editor/languages/languages"],
            "editor/promptWidget": ["../app/editor/promptWidget/promptWidget"],
            "editor/utils": ["../app/editor/utils/utils"],
            "shared/analytics": ["../../shared/modules/analytics/analytics"],
            "shared/loader": ["../../shared/modules/loader/loader"],
            "shared/markdown": ["../../shared/modules/markdown/markdown"],
            "shared/sf": ["../../shared/modules/sf/sf"],
            "slds/MarkdownViewerEditorModal": ["../app/component/slds/MarkdownViewerEditorModal/MarkdownViewerEditorModal"],
            "slds/codeBlock": ["../app/component/slds/codeBlock/codeBlock"],
            "slds/hashtagDropdown": ["../app/component/slds/hashtagDropdown/hashtagDropdown"],
            "slds/modalUserSelector": ["../app/component/slds/modalUserSelector/modalUserSelector"]
        },
        "outDir": ".",
        "sourceMap": true,
        "declaration": false,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true
    },
    "include": ["**/*.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
