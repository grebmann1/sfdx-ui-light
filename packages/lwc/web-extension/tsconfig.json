{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["ES2020", "DOM"],
        "baseUrl": ".",
        "paths": {
            "shared/*": ["../../shared/modules/*"]
        },
        "outDir": ".",
        "sourceMap": true,
        "declaration": false,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true
    },
    "include": ["**/*.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
