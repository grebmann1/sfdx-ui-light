{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["ES2020", "DOM"],
        "baseUrl": ".",
        "paths": {
            "application/*": ["application/*"],
            "component/*": ["component/*"],
            "connection/*": ["connection/*"],
            "core/*": ["core/*"],
            "editor/*": ["editor/*"],
            "pages/*": ["pages/*"],
            "tools/*": ["tools/*"],
            "agent/*": ["agent/*"],
            "ai/*": ["ai/*"],
            "skeleton/*": ["component/skeleton/*"],
            "slds/*": ["component/slds/*"],
            "illustration/*": ["component/illustration/*"],
            "shared/*": ["../../shared/modules/*"],
            "agent/agents": ["agent/agents/agents"],
            "ai/assistants": ["ai/assistants/assistants"],
            "ai/functions": ["ai/functions/functions"],
            "ai/utils": ["ai/utils/utils"],
            "connection/app": ["connection/app/app"],
            "connection/connectionDetailModal": [
                "connection/connectionDetailModal/connectionDetailModal"
            ],
            "connection/connectionImportModal": [
                "connection/connectionImportModal/connectionImportModal"
            ],
            "connection/connectionManualModal": [
                "connection/connectionManualModal/connectionManualModal"
            ],
            "connection/connectionNewModal": ["connection/connectionNewModal/connectionNewModal"],
            "connection/quickConnect": ["connection/quickConnect/quickConnect"],
            "connection/shareUtils": ["connection/shareUtils/shareUtils"],
            "core/applications": ["core/applications/applications"],
            "core/constant": ["core/constant/constant"],
            "editor/editorCompleteWidget": ["editor/editorCompleteWidget/editorCompleteWidget"],
            "editor/languages": ["editor/languages/languages"],
            "editor/promptWidget": ["editor/promptWidget/promptWidget"],
            "editor/utils": ["editor/utils/utils"],
            "illustration/illustration": ["component/illustration/illustration/illustration"],
            "shared/analytics": ["../../shared/modules/analytics/analytics"],
            "shared/llm": ["../../shared/modules/llm/llm"],
            "shared/loader": ["../../shared/modules/loader/loader"],
            "shared/markdown": ["../../shared/modules/markdown/markdown"],
            "shared/sf": ["../../shared/modules/sf/sf"],
            "skeleton/app": ["component/skeleton/app/app"],
            "skeleton/modalLauncher": ["component/skeleton/modalLauncher/modalLauncher"],
            "skeleton/registry": ["component/skeleton/registry/registry"],
            "skeleton/sessionExpiredModal": [
                "component/skeleton/sessionExpiredModal/sessionExpiredModal"
            ],
            "lwr/navigation": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/navigation/navigation"
            ],
            "lwr/router": ["../../node_modules/@lwrjs/router/build/es/modules/lwr/router/router"],
            "lwr/navigationContext": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/navigationContext/navigationContext"
            ],
            "lwr/currentPageReference": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/currentPageReference/currentPageReference"
            ],
            "lwr/currentView": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/currentView/currentView"
            ],
            "lwr/routerUtils": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/routerUtils/routerUtils"
            ],
            "lwr/contextUtils": [
                "../../node_modules/@lwrjs/router/build/es/modules/lwr/contextUtils/contextUtils"
            ],
            "slds/MarkdownViewerEditorModal": [
                "component/slds/MarkdownViewerEditorModal/MarkdownViewerEditorModal"
            ],
            "slds/codeBlock": ["component/slds/codeBlock/codeBlock"],
            "slds/hashtagDropdown": ["component/slds/hashtagDropdown/hashtagDropdown"],
            "slds/modalUserSelector": ["component/slds/modalUserSelector/modalUserSelector"]
        },
        "outDir": ".",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "sourceMap": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true
    },
    "include": ["**/*.js", "**/*.ts", "types/**/*.d.ts", "../../shared/modules/types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
