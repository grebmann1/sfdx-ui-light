{
    "name": "@sf-toolkit/desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Electron desktop shell for sf-toolkit-web",
    "main": "dist/main/desktopMain.js",
    "bin": {
        "sf-toolkit-desktop": "dist/cli/desktopCli.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:renderer": "npm --prefix ../.. run build:web",
        "test": "npm run build && node --test dist/**/*.test.js",
        "start": "npm run build && electron .",
        "start:dev": "npm run build && wait-on http://localhost:3000 && electron .",
        "cli": "npm run build && node dist/cli/desktopCli.js",
        "package": "npm run build:renderer && npm run build && electron-forge package",
        "make": "npm run build:renderer && npm run build && electron-forge make"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.11.1",
        "@electron-forge/maker-dmg": "^7.11.1",
        "@electron-forge/maker-zip": "^7.11.1",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
        "@electron-forge/plugin-fuses": "^7.11.1",
        "@electron-forge/publisher-github": "^7.11.1",
        "@electron/fuses": "^1.8.0",
        "@types/node": "^25.6.0",
        "electron": "^41.2.0",
        "typescript": "^6.0.2",
        "wait-on": "^9.0.5"
    }
}
