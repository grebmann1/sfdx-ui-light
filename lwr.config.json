{
    "layoutsDir": "$rootDir/packages/server/layouts",
    "contentDir": "$rootDir/packages/server/content",
    "lwc": {
        "modules": [
            { "dir": "$rootDir/packages/lwc/app" },
            { "dir": "$rootDir/packages/lwc/app/component" },
            { "dir": "$rootDir/packages/lwc/app/application" },
            { "dir": "$rootDir/packages/lwc/app/pages" },
            { "dir": "$rootDir/packages/lwc/app/pages/documentation" },
            { "dir": "$rootDir/packages/lwc/app/tools" },
            { "dir": "$rootDir/packages/lwc/web-extension" },
            {
                "name": "shared/analytics",
                "path": "$rootDir/packages/shared/dist/modules/analytics/analytics.js"
            },
            {
                "name": "shared/cacheManager",
                "path": "$rootDir/packages/shared/dist/modules/cacheManager/cacheManager.js"
            },
            { "name": "shared/llm", "path": "$rootDir/packages/shared/dist/modules/llm/llm.js" },
            {
                "name": "shared/loader",
                "path": "$rootDir/packages/shared/dist/modules/loader/loader.js"
            },
            {
                "name": "shared/logger",
                "path": "$rootDir/packages/shared/dist/modules/logger/logger.js"
            },
            {
                "name": "shared/markdown",
                "path": "$rootDir/packages/shared/dist/modules/markdown/markdown.js"
            },
            {
                "name": "shared/middleware",
                "path": "$rootDir/packages/shared/dist/modules/middleware/middleware.js"
            },
            { "name": "shared/sf", "path": "$rootDir/packages/shared/dist/modules/sf/sf.js" },
            {
                "name": "shared/store",
                "path": "$rootDir/packages/shared/dist/modules/store/store.js"
            },
            {
                "name": "shared/utils",
                "path": "$rootDir/packages/shared/dist/modules/utils/utils.js"
            },
            { "name": "agent/utils", "path": "$rootDir/packages/lwc/app/agent/utils/utils.ts" },
            {
                "name": "core/store/storeRef",
                "path": "$rootDir/packages/lwc/app/core/store/storeRef.ts"
            },
            {
                "name": "core/connector",
                "path": "$rootDir/packages/lwc/app/core/connector/connector.ts"
            },
            {
                "name": "connection/app",
                "path": "$rootDir/packages/lwc/app/connection/app/app.ts"
            },
            { "npm": "lightning-base-components" },
            {
                "name": "imported/jsforce",
                "path": "$rootDir/packages/server/assets/libs/jsforce/jsforce.js"
            },
            {
                "name": "imported/openapi-parser",
                "path": "$rootDir/packages/server/assets/libs/openapi-parser/openapi-parser.esm.min.js"
            },
            {
                "name": "just-bash",
                "path": "$rootDir/packages/server/assets/libs/just-bash/just-bash.browser.js"
            },
            {
                "name": "feature-input-quick-pick",
                "path": "$rootDir/packages/lwc/web-extension/feature/inputQuickPick/inputQuickPick.js"
            }
        ]
    },
    "assets": [
        {
            "alias": "assets",
            "dir": "$rootDir/node_modules/@salesforce-ux/design-system/assets",
            "urlPath": "/assets"
        },
        {
            "file": "$rootDir/node_modules/xterm/css/xterm.css",
            "urlPath": "/xterm.css"
        },
        {
            "alias": "imagesDir",
            "dir": "$rootDir/packages/server/assets/images",
            "urlPath": "/images"
        },
        {
            "alias": "gifsDir",
            "dir": "$rootDir/packages/server/assets/gifs",
            "urlPath": "/gifs"
        },
        {
            "alias": "stylesDir",
            "dir": "$rootDir/packages/server/assets/styles",
            "urlPath": "/styles"
        },
        {
            "alias": "libsDir",
            "dir": "$rootDir/packages/server/assets/libs",
            "urlPath": "/libs"
        },
        {
            "file": "$rootDir/packages/server/assets/favicon.ico",
            "urlPath": "/favicon.ico"
        },
        {
            "alias": "workersDir",
            "dir": "$rootDir/packages/workers/src",
            "urlPath": "/workers"
        },
        {
            "alias": "skillsPublicDir",
            "dir": "$rootDir/assets/skills",
            "urlPath": "/public/skills"
        },
        {
            "alias": "publicDir",
            "dir": "$rootDir/packages/server/assets",
            "urlPath": "/public"
        }
    ],
    "hooks": ["$rootDir/packages/server/dist/hooks/application-hook.js"],
    "routes": [
        {
            "id": "home",
            "path": "/",
            "contentTemplate": "$contentDir/home.html",
            "layoutTemplate": "$layoutsDir/home.html",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "app",
            "path": "/app",
            "rootComponent": "skeleton/fullView",
            "layoutTemplate": "$layoutsDir/main.html",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "markdown",
            "path": "/markdown",
            "rootComponent": "skeleton/markdownView",
            "layoutTemplate": "$layoutsDir/main.html",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "extension",
            "path": "/extension",
            "rootComponent": "skeleton/directView",
            "layoutTemplate": "$layoutsDir/main.html",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "callback",
            "path": "/callback",
            "rootComponent": "connection/callback",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "CTA",
            "path": "/cta",
            "rootComponent": "cta/app",
            "layoutTemplate": "$layoutsDir/cta.html",
            "cache": { "ttl": 60 },
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "install",
            "path": "/install",
            "rootComponent": "onboarding/installPage",
            "layoutTemplate": "$layoutsDir/install.html",
            "bootstrap": {
                "syntheticShadow": true
            }
        }
    ],
    "staticSiteGenerator": {
        "_additionalModules": ["@lwc/synthetic-shadow", "lwc"]
    }
}
